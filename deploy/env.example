# /srv/barometer/data/.env  (chmod 600, owned by barometer)
BAROMETER_DATA_DIR=/srv/barometer/data
BAROMETER_TZ=Europe/London

# Claude API (extraction and briefs). Note text leaves the Pi for these calls,
# with names swapped for refs (P12) where practical.
ANTHROPIC_API_KEY=sk-ant-...
BAROMETER_LLM=claude
BAROMETER_MODEL=claude-opus-5-5
BAROMETER_EFFORT_EXTRACT=medium
BAROMETER_EFFORT_BRIEF=low
BAROMETER_PSEUDONYMISE=1

# Behind `tailscale serve` the browser sees HTTPS, so cookies stay Secure.
BAROMETER_SECURE_COOKIES=1
BAROMETER_SESSION_IDLE_SECONDS=600
# Argon2id cost for the Private passphrase: interactive | moderate | sensitive
BAROMETER_KDF_STRENGTH=moderate

# Voice (optional): pip install '.[voice]' for faster-whisper, or point at whisper.cpp
BAROMETER_WHISPER_MODEL=base
# BAROMETER_WHISPER_CPP_BIN=/opt/whisper.cpp/main
# BAROMETER_WHISPER_CPP_MODEL=/opt/whisper.cpp/models/ggml-base.en.bin

# Weekly push via your own ntfy server (neutral text, no names)
# BAROMETER_NTFY_URL=http://100.x.y.z:8080/barometer-7f3a9c

# Nightly encrypted backups (03:00 local). Make the key pair OFF the Pi:
#   barometer backup-keygen   -> keep the private key elsewhere, paste the public key here
# BAROMETER_BACKUP_DIR=/mnt/barometer-backup
# BAROMETER_BACKUP_PUBLIC_KEY=
BAROMETER_BACKUP_KEEP=14

# Optional: encrypt the Almanac DB with SQLCipher as well (64 hex chars in the file)
# BAROMETER_ALMANAC_KEY_FILE=/srv/barometer/data/almanac.key
