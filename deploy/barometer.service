# /etc/systemd/system/barometer.service
[Unit]
Description=Barometer
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=barometer
Group=barometer
WorkingDirectory=/srv/barometer
EnvironmentFile=/srv/barometer/data/.env
# Listens on localhost only; `tailscale serve` is the only way in.
ExecStart=/srv/barometer/venv/bin/barometer serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/barometer/data /mnt/barometer-backup
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
UMask=0077
# Never write Deep plaintext to swap.
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
